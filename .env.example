# ── Server-only (never exposed to the browser) ─────────────────────────────
# Google Apps Script web app URL (Deploy → Web app → URL ending in /exec),
# deployed from the contact@nomadictravel.co.in Google account. See README.
LEADS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
# Shared secret checked by Code.gs (Script properties → LEADS_SECRET). Use a long random string.
LEADS_SECRET=change-me-to-a-long-random-string

# ── Public (inlined into the client bundle) ────────────────────────────────
# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=916000060220
# Canonical site URL used for canonical tags, sitemap, schema and OG images.
NEXT_PUBLIC_SITE_URL=https://www.nomadictravel.co.in
# Google Search Console HTML-tag verification token (content="…" value only). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID (G-XXXXXXX). Optional; GA loads lazily when set.
NEXT_PUBLIC_GA_ID=
# Google Maps browser key (Maps Static API, Maps JavaScript API, Maps Embed API, Routes API).
# Restrict by HTTP referrer to your domains + localhost. Leave empty to hide all maps.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map ID for Advanced Markers (Cloud console → Map Management). DEMO_MAP_ID is used when empty (dev only).
NEXT_PUBLIC_GOOGLE_MAP_ID=
